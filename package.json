{
  "name": "klinik-core-sdk",
  "version": "1.0.0",
  "description": "Generic utilities for Klinik Management System",
  "module": "src/index.ts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.30.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "hospital",
    "sdk",
    "api",
    "healthcare"
  ],
  "license": "MIT"
}
